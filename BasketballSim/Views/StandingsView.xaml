<Window x:Class="BasketballSim.Views.StandingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Title="Standings">
    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- conference tables -->
            <RowDefinition Height="Auto"/>   <!-- stats leaders -->
            <RowDefinition Height="Auto"/>   <!-- button -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Background="#16213e" Padding="20,14">
            <TextBlock Text="FINAL STANDINGS" FontSize="28" FontWeight="Bold"
                       Foreground="#e2b714" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Conference tables -->
        <Grid Grid.Row="1" Margin="30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock Text="Western Conference" FontSize="20" FontWeight="Bold"
                           Foreground="#e2b714" Margin="0,0,0,8"/>
                <ListBox x:Name="WestList" Background="#0f3460"
                         Foreground="White" BorderThickness="0"
                         FontSize="14" FontFamily="Consolas"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                <TextBlock Text="Eastern Conference" FontSize="20" FontWeight="Bold"
                           Foreground="#e2b714" Margin="0,0,0,8"/>
                <ListBox x:Name="EastList" Background="#0f3460"
                         Foreground="White" BorderThickness="0"
                         FontSize="14" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>

        <!-- Stats leaders -->
        <Border Grid.Row="2" Background="#16213e" Padding="30,14" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="LEAGUE LEADERS" FontSize="16" FontWeight="Bold"
                           Foreground="#e2b714" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PpgLeaderText"  Grid.Column="0" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RpgLeaderText"  Grid.Column="1" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ApgLeaderText"  Grid.Column="2" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SpgLeaderText"  Grid.Column="3" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BpgLeaderText"  Grid.Column="4" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Playoffs button -->
        <Button Grid.Row="3" Content="View Playoffs →" Width="200" Height="44"
                Margin="0,16,0,20" HorizontalAlignment="Center"
                Background="#e2b714" Foreground="#1a1a2e"
                FontSize="15" FontWeight="Bold"
                Click="ViewPlayoffs_Click"/>
    </Grid>
</Window>
