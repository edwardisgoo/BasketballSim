<Window x:Class="BasketballSim.Views.PlayoffView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Title="Playoffs">
    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#16213e" Padding="20,12">
            <TextBlock Text="PLAYOFFS" FontSize="28" FontWeight="Bold"
                       Foreground="#e2b714" HorizontalAlignment="Center"/>
            <TextBlock x:Name="InstructionText"
                       Text="Press ENTER to simulate the next game"
                       FontSize="13" Foreground="#aaaaaa"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Bracket columns -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Round1Panel" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
            <StackPanel x:Name="Round2Panel" Grid.Column="1" Margin="10" VerticalAlignment="Center"/>
            <StackPanel x:Name="Round3Panel" Grid.Column="2" Margin="10" VerticalAlignment="Center"/>

            <!-- Champion box -->
            <Border Grid.Column="3" BorderBrush="#e2b714" BorderThickness="2"
                    Background="#0f3460" Padding="20" Margin="10"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200">
                <StackPanel>
                    <TextBlock Text="CHAMPION" FontSize="14" FontWeight="Bold"
                               Foreground="#e2b714" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ChampionNameText" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer hint -->
        <TextBlock Grid.Row="2" x:Name="ChampionBanner"
                   Text="" FontSize="20" FontWeight="Bold"
                   Foreground="#e2b714" HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>
    </Grid>
</Window>
